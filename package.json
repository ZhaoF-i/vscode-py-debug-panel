{
  "name": "vscode-py-debug-panel",
  "displayName": "Python Debug Panel",
  "description": "Paste shell-style Python script arguments in a sidebar panel and run or debug Python files.",
  "version": "0.1.1",
  "publisher": "zhaofei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhaoF-i/vscode-py-debug-panel.git"
  },
  "bugs": {
    "url": "https://github.com/ZhaoF-i/vscode-py-debug-panel/issues"
  },
  "homepage": "https://github.com/ZhaoF-i/vscode-py-debug-panel#readme",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onView:pythonDebugPanel.view",
    "onCommand:pythonDebugPanel.open",
    "onCommand:pythonDebugPanel.debugSelected",
    "onCommand:pythonDebugPanel.runSelected",
    "onCommand:pythonDebugPanel.refreshFiles"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.4.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "pythonDebugPanel.open",
        "title": "Python Debug Panel: Open"
      },
      {
        "command": "pythonDebugPanel.debugSelected",
        "title": "Python Debug Panel: Debug Selected"
      },
      {
        "command": "pythonDebugPanel.runSelected",
        "title": "Python Debug Panel: Run Selected"
      },
      {
        "command": "pythonDebugPanel.refreshFiles",
        "title": "Python Debug Panel: Refresh Files"
      }
    ],
    "configuration": {
      "title": "Python Debug Panel",
      "properties": {
        "pythonDebugPanel.debugType": {
          "type": "string",
          "default": "debugpy",
          "enum": [
            "debugpy",
            "python"
          ],
          "description": "Debug configuration type used when launching Python files."
        },
        "pythonDebugPanel.historyLimit": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Number of recent argument blocks to keep per workspace."
        },
        "pythonDebugPanel.console": {
          "type": "string",
          "default": "integratedTerminal",
          "enum": [
            "integratedTerminal",
            "internalConsole",
            "externalTerminal"
          ],
          "description": "Console used for launched Python debug sessions."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pythonDebugPanel",
          "title": "Python Debug",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "pythonDebugPanel": [
        {
          "type": "webview",
          "id": "pythonDebugPanel.view",
          "name": "Debug Panel"
        }
      ]
    }
  }
}
